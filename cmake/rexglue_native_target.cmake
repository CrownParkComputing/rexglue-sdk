# Optional standalone native runtime/Vulkan integration. The caller supplies a
# native main and an explicit or bundled platform; SDK runtime/GPU shared targets
# are not linked by this function.
include_guard(GLOBAL)

function(_rexglue_validate_native_link_graphs)
  get_property(native_targets DIRECTORY PROPERTY REXGLUE_STANDALONE_NATIVE_TARGETS)
  foreach(native_target IN LISTS native_targets)
    set(queue "${native_target}")
    set(visited)
    while(queue)
      list(POP_FRONT queue dependency_target)
      if(dependency_target IN_LIST visited)
        continue()
      endif()
      list(APPEND visited "${dependency_target}")
      foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
        get_target_property(dependencies ${dependency_target} ${property})
        if(NOT dependencies)
          continue()
        endif()
        foreach(dependency IN LISTS dependencies)
          if(dependency MATCHES "rex::(runtime|system|kernel|gpu[-:>])|rexruntime|rexgpu[-_]")
            message(FATAL_ERROR "Standalone native target ${native_target} also links SDK runtime/GPU dependency ${dependency}; use one runtime/backend")
          endif()
          string(REGEX REPLACE "^\\$<(LINK_ONLY|BUILD_INTERFACE):(.*)>$" "\\2" concrete "${dependency}")
          if(TARGET "${concrete}")
            list(APPEND queue "${concrete}")
          endif()
        endforeach()
      endforeach()
    endwhile()
  endforeach()
endfunction()

function(rexglue_setup_native_target target)
  cmake_parse_arguments(NATIVE ""
    "PLATFORM_ROOT;GENERATED_ROOT;TITLE;OUTPUT_DIRECTORY;IMPORTS_OUTPUT" "MODULES" ${ARGN})
  if(NATIVE_UNPARSED_ARGUMENTS OR
      NOT NATIVE_GENERATED_ROOT OR NOT NATIVE_TITLE OR NOT TARGET ${target})
    message(FATAL_ERROR "rexglue_setup_native_target(existing_executable [PLATFORM_ROOT path] GENERATED_ROOT path TITLE prefix MODULES default [...])")
  endif()
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR
      NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64)$" OR
      NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    message(FATAL_ERROR "The standalone native platform currently requires Linux x86-64 and Clang")
  endif()
  get_target_property(target_type ${target} TYPE)
  get_target_property(attached ${target} REXGLUE_NATIVE_PLATFORM_ROOT)
  if(NOT target_type STREQUAL "EXECUTABLE" OR attached)
    message(FATAL_ERROR "Attach the standalone native platform once to a normal executable target")
  endif()
  if(NOT NATIVE_TITLE MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
    message(FATAL_ERROR "TITLE must match the generated module's C++ prefix")
  endif()
  if(NOT NATIVE_MODULES)
    set(NATIVE_MODULES default)
  endif()
  foreach(module IN LISTS NATIVE_MODULES)
    if(NOT module MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
      message(FATAL_ERROR "Invalid generated module name: ${module}")
    endif()
  endforeach()
  list(LENGTH NATIVE_MODULES module_count)
  set(unique_modules ${NATIVE_MODULES})
  list(REMOVE_DUPLICATES unique_modules)
  list(LENGTH unique_modules unique_count)
  if(NOT module_count EQUAL unique_count)
    message(FATAL_ERROR "Duplicate native module")
  endif()
  if(NOT NATIVE_PLATFORM_ROOT)
    if(REXGLUE_NATIVE_PLATFORM_ROOT AND EXISTS "${REXGLUE_NATIVE_PLATFORM_ROOT}/platform.cmake")
      set(NATIVE_PLATFORM_ROOT "${REXGLUE_NATIVE_PLATFORM_ROOT}")
    endif()
    foreach(candidate
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../../share/rexglue/native_platform/native"
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../native_platform/native")
      if(NOT NATIVE_PLATFORM_ROOT AND EXISTS "${candidate}/platform.cmake" AND EXISTS "${candidate}/../manifest.json")
        set(NATIVE_PLATFORM_ROOT "${candidate}")
        break()
      endif()
    endforeach()
    if(NOT NATIVE_PLATFORM_ROOT)
      message(FATAL_ERROR "Install the optional NativeBackend component or pass PLATFORM_ROOT explicitly")
    endif()
  endif()
  get_filename_component(platform "${NATIVE_PLATFORM_ROOT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  get_filename_component(generated "${NATIVE_GENERATED_ROOT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  foreach(required platform.cmake prepare_codegen.py prepare_imports.py)
    if(NOT EXISTS "${platform}/${required}")
      message(FATAL_ERROR "Native platform file is missing: ${platform}/${required}")
    endif()
  endforeach()
  foreach(module IN LISTS NATIVE_MODULES)
    if(NOT EXISTS "${generated}/${module}/${NATIVE_TITLE}_init.cpp")
      message(FATAL_ERROR "Generate ${module} locally before configuring the native target")
    endif()
  endforeach()
  if(NATIVE_OUTPUT_DIRECTORY)
    get_filename_component(output "${NATIVE_OUTPUT_DIRECTORY}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
  else()
    set(output "${CMAKE_CURRENT_BINARY_DIR}/${target}_native/generated")
  endif()
  if(NATIVE_IMPORTS_OUTPUT)
    get_filename_component(imports "${NATIVE_IMPORTS_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
  else()
    set(imports "${CMAKE_CURRENT_BINARY_DIR}/${target}_native/unsupported_imports.cpp")
  endif()
  # Prevent the build adapter from writing over the title's original output.
  cmake_path(IS_PREFIX generated "${output}" NORMALIZE output_inside_original)
  cmake_path(IS_PREFIX output "${generated}" NORMALIZE original_inside_output)
  if(output_inside_original OR original_inside_output)
    message(FATAL_ERROR "Native build copies must be separate from original generated modules")
  endif()
  find_package(Python3 3.11 REQUIRED COMPONENTS Interpreter)
  if(EXISTS "${platform}/../manifest.json")
    set(bundle_verified FALSE)
    foreach(verifier
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../../share/rexglue/native_graphics/export_native_platform.py"
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/native_graphics/export_native_platform.py")
      if(EXISTS "${verifier}")
        execute_process(COMMAND "${Python3_EXECUTABLE}" "${verifier}"
          --verify-bundle "${platform}/.." COMMAND_ERROR_IS_FATAL ANY)
        set(bundle_verified TRUE)
        break()
      endif()
    endforeach()
    if(NOT bundle_verified)
      message(FATAL_ERROR "Bundled native source verifier is missing")
    endif()
  endif()
  set(CMAKE_CXX_STANDARD 23)
  set(CMAKE_CXX_STANDARD_REQUIRED ON)
  set(CMAKE_C_STANDARD 11)
  if(NOT TARGET xn_runtime)
    include("${platform}/platform.cmake")
  else()
    get_target_property(runtime_source xn_runtime SOURCE_DIR)
    get_filename_component(expected_runtime "${platform}/runtime" REALPATH)
    get_filename_component(runtime_source "${runtime_source}" REALPATH)
    if(NOT runtime_source STREQUAL expected_runtime)
      message(FATAL_ERROR "A different standalone native platform is already configured")
    endif()
  endif()
  get_directory_property(directory_options COMPILE_OPTIONS)
  set(native_arch_option)
  if(NOT "-march=x86-64-v3" IN_LIST directory_options)
    set(native_arch_option -march=x86-64-v3)
  endif()
  foreach(runtime_target xn_loader xn_memory_watch xn_runtime xn_audio xn_audio_imports
      xn_shader_translator xn_renderer_vulkan xn_native_options)
    if(TARGET ${runtime_target})
      target_compile_features(${runtime_target} PUBLIC cxx_std_23)
      if(native_arch_option)
        target_compile_options(${runtime_target} PRIVATE ${native_arch_option})
      endif()
    endif()
  endforeach()
  # SDK-exported SDL3-static brings the SDK's general include/ directory.
  # Audio imports require this platform's kernel/PPC contract instead of the
  # SDK hook/logging headers that may otherwise precede transitive xn_runtime.
  target_include_directories(xn_audio_imports BEFORE PRIVATE
    "${platform}/runtime/ppc/include" "${platform}/runtime")
  file(GLOB_RECURSE codegen_inputs CONFIGURE_DEPENDS "${generated}/*.cpp" "${generated}/*.h")
  file(GLOB_RECURSE runtime_sources CONFIGURE_DEPENDS "${platform}/runtime/*.cpp")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${codegen_inputs}
    ${runtime_sources} "${platform}/prepare_codegen.py" "${platform}/prepare_imports.py")
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${platform}/prepare_codegen.py"
    "${generated}" "${output}" --title "${NATIVE_TITLE}" --modules ${NATIVE_MODULES}
    COMMAND_ERROR_IS_FATAL ANY)
  string(TOUPPER "${NATIVE_TITLE}" title_upper)
  set(object_targets)
  foreach(module IN LISTS NATIVE_MODULES)
    string(TOUPPER "${module}" module_upper)
    include("${output}/${module}/sources.cmake")
    if(module_count EQUAL 1)
      set(object_target "${target}_game")
    else()
      set(object_target "${target}_${module}")
    endif()
    add_library(${object_target} OBJECT ${${title_upper}_${module_upper}_SOURCES})
    target_link_libraries(${object_target} PRIVATE xn_runtime)
    target_include_directories(${object_target} PRIVATE "${output}/${module}")
    target_precompile_headers(${object_target} PRIVATE "${output}/${module}/${NATIVE_TITLE}_pch.h")
    target_compile_options(${object_target} PRIVATE -O2 -gline-tables-only -w
      -fno-strict-aliasing ${native_arch_option})
    list(APPEND object_targets ${object_target})
    target_include_directories(${target} PRIVATE "${output}/${module}")
  endforeach()
  if(NATIVE_TITLE STREQUAL "midnightclubla")
    target_sources(${target} PRIVATE "${platform}/graphics_adapters/mcla_tiling.cpp")
  elseif(NATIVE_TITLE STREQUAL "forza4")
    target_sources(${target} PRIVATE "${platform}/graphics_adapters/forza4_tiling.cpp")
  endif()
  get_filename_component(import_directory "${imports}" DIRECTORY)
  file(MAKE_DIRECTORY "${import_directory}")
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${platform}/prepare_imports.py"
    "${generated}" "${platform}/runtime" "${imports}" COMMAND_ERROR_IS_FATAL ANY)
  target_sources(${target} PRIVATE "${imports}")
  target_compile_features(${target} PRIVATE cxx_std_23)
  if(native_arch_option)
    target_compile_options(${target} PRIVATE ${native_arch_option})
  endif()
  target_link_libraries(${target} PRIVATE ${object_targets}
    xn_runtime xn_renderer_vulkan xn_audio_imports xn_native_options)
  set_target_properties(${target} PROPERTIES
    REXGLUE_NATIVE_PLATFORM_ROOT "${platform}"
    REXGLUE_NATIVE_GENERATED_DIRECTORY "${output}"
    REXGLUE_NATIVE_OBJECT_TARGETS "${object_targets}")
  # Evaluate after the caller has finished adding its own libraries as well.
  # Directory properties retain the targets when this function's scope ends.
  get_property(check_scheduled DIRECTORY PROPERTY REXGLUE_NATIVE_LINK_CHECK_SCHEDULED)
  set_property(DIRECTORY APPEND PROPERTY REXGLUE_STANDALONE_NATIVE_TARGETS "${target}")
  if(NOT check_scheduled)
    cmake_language(DEFER CALL _rexglue_validate_native_link_graphs)
    set_property(DIRECTORY PROPERTY REXGLUE_NATIVE_LINK_CHECK_SCHEDULED TRUE)
  endif()
endfunction()
