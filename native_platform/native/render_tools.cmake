# Shared, asset-free renderer tools for native title ports.
enable_testing()
find_package(Threads REQUIRED)
add_executable(xn_guest_delay_policy_probe
  "${XN_PLATFORM_ROOT}/../tools/native_graphics/guest_delay_hint_probe.cpp")
target_link_libraries(xn_guest_delay_policy_probe PRIVATE Threads::Threads)
add_test(NAME native.guest_delay_policy COMMAND xn_guest_delay_policy_probe)
add_test(NAME native.prepare_codegen
  COMMAND "${Python3_EXECUTABLE}" -B "${XN_PLATFORM_ROOT}/prepare_codegen_probe.py"
          "${XN_PLATFORM_ROOT}/prepare_codegen.py")
set_tests_properties(native.prepare_codegen PROPERTIES TIMEOUT 60)

add_executable(xn_draw_batch_profile_probe "${XN_PLATFORM_ROOT}/draw_batch_profile_probe.cpp")
target_include_directories(xn_draw_batch_profile_probe PRIVATE "${XN_PLATFORM_ROOT}/runtime")
add_test(NAME native.draw_batch_profile COMMAND xn_draw_batch_profile_probe)
add_executable(xn_render_capture_probe "${XN_PLATFORM_ROOT}/render_capture_probe.cpp"
  "${XN_PLATFORM_ROOT}/runtime/gfx/vulkan/render_capture.cpp")
target_link_libraries(xn_render_capture_probe PRIVATE xn_render_trace xn_memory_watch)
target_compile_options(xn_render_capture_probe PRIVATE -UNDEBUG)
add_test(NAME native.render_capture COMMAND xn_render_capture_probe)
set_tests_properties(native.render_capture PROPERTIES TIMEOUT 60)
