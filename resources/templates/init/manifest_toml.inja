# Generated by ReXGlue v{{ sdk_version_full }} on {{ generated_on }}.

[project]
name = "{{ names.snake_case }}"
{% if include_stamp -%}
sdk_version = "{{ sdk_version }}"
{% endif -%}
{% if game_root -%}
game_root = "{{ game_root }}"
{% endif %}
[entrypoint]
file_path = "{{ xex_path }}"
out_directory_path = "{{ out_directory_path }}"
includes = []

# Keep the PowerPC non-volatile registers in C++ locals rather than in the
# guest context. Two effects, both measured on SoulCalibur II: the
# __savegprlr_N/__restgprlr_N helper calls that every prologue and epilogue
# makes disappear entirely - they were 9% of all profile samples - and the
# compiler can then hold those registers in host registers instead of
# reloading them from the context on each use.
#
# Verified rendering-correct on SoulCalibur II HD and Banjo-Kazooie. Turn it
# off for a title that misbehaves in a way that looks like stale register
# state, since it does change what the generated code does between calls.
non_volatile_as_local = true

# Codegen finds the save/restore helpers and the switch tables on its own, but
# it does NOT find setjmp/longjmp. Undeclared, the longjmp is emitted as an
# ORDINARY CALL: the helper loads the saved registers into the context and
# returns normally, so control never unwinds and the caller carries on with
# non-volatile registers restored from a stale jmp_buf. The symptom appears
# nowhere near the cause - an unrelated function calls a pointer it never
# computed, which the runtime logs as [UNREGFN] at an address outside the code
# range, and the title renders nothing. Both Geometry Wars titles were black
# for exactly this reason and needed only these two lines.
#
# Identify the pair by register set: longjmp restores f14-f31, r13-r31, LR, CR
# and r1 from a buffer and returns; setjmp saves the same fields at the same
# offsets. Uncomment and fill in if a port shows that symptom.
# longjmp_address = 0x00000000
# setjmp_address  = 0x00000000
{% for m in modules %}
[[modules]]
guest_path = "{{ m.guest_path }}"
file_path = "{{ m.file_path }}"
out_directory_path = "{{ m.out_directory_path }}"
includes = []
{% endfor -%}
