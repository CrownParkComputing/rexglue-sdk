def gen_overrides_cpp(ing, lib, entries, table_rel):
    """Same shape as pgr4-recomp/tools/d3d/hookgen.py: one REX_HOOK_RAW per
    entry, counter + effective-mode switch, weak Tee/Native bindings."""
    ns = lib + "native"
    hdr = "%snative/%s_native.h" % (lib, lib)
    prefix = "sub_"
    names = {}
    for e in entries:
        if not IDENT_RE.match(e["name"]):
            sys.exit("%08X: name %r is not a C identifier" % (e["address"], e["name"]))
        if e["name"] in names:
            sys.exit("duplicate name %r at %08X and %08X" % (e["name"], e["address"], names[e["name"]]))
        names[e["name"]] = e["address"]
    if sum(1 for e in entries if e["role"] == "present") > 1:
        sys.exit("more than one entry has role = present")
    L = []
    w = L.append
    w("// GENERATED FILE - DO NOT EDIT.")
    w("// Written by `rexnative emit` from %s." % table_rel)
    w("// Regenerate:  rexnative emit <port> --lib %s" % lib)
    w("//")
    w("// One strong override per api_table.toml entry. Each displaces the weak")
    w("// generated alias sub_X; the generated body remains reachable as __imp__sub_X.")
    w("// Behaviour per effective mode is decided at runtime by %s::Init()." % ns)
    w("// Every entry starts in guest mode (forward unchanged); the measured call")
    w("// frequency from the harvest is in the comment above each override.")
    w("")
    w("#include <atomic>")
    w("#include <cstddef>")
    w("#include <cstdint>")
    w("")
    w("#include <rex/hook.h>")
    w("")
    w('#include "%s"' % hdr)
    w("")
    w("// Generated bodies.")
    for e in entries:
        w("REX_EXTERN(__imp__%s%08X);" % (prefix, e["address"]))
    w("")
    w("// Native bindings. Weak: an entry without an implementation links and its")
    w("// pointer is null. Define these (same signature, strong) in any port TU.")
    w("namespace %s::hooks {" % ns)
    for e in entries:
        a = "%08X" % e["address"]
        w("__attribute__((weak)) void TeePre_%s(PPCContext& ctx, uint8_t* base);    // %s" % (a, e["name"]))
        w("__attribute__((weak)) void TeePost_%s(PPCContext& ctx, uint8_t* base);" % a)
        w("__attribute__((weak)) void Native_%s(PPCContext& ctx, uint8_t* base);" % a)
    w("}  // namespace %s::hooks" % ns)
    w("")
    w("namespace %s {" % ns)
    w("")
    w("const std::size_t kEntryCount = %d;" % len(entries))
    w("std::atomic<uint64_t> g_counts[%d] = {};" % len(entries))
    w("std::atomic<uint8_t> g_effective[%d] = {};  // Init() fills; 0 == kGuest" % len(entries))
    w("")
    w("const Entry kEntries[] = {")
    for e in entries:
        a = "%08X" % e["address"]
        w("    {0x%s, %s, %d, Mode::%s, Role::%s," % (a, cpp_str(e["name"]), e["arity"] or 0,
                                                       MODES[e["mode"]], ROLES[e["role"]]))
        w("     &__imp__%s%s, &hooks::TeePre_%s, &hooks::TeePost_%s, &hooks::Native_%s}," % (prefix, a, a, a, a))
    w("};")
    w("")
    w("}  // namespace %s" % ns)
    w("")
    w("using %s::Mode;" % ns)
    w("")
    for idx, e in enumerate(entries):
        a = "%08X" % e["address"]
        sym = prefix + a
        note = (e["note"] + "; ") if e["note"] and e["note"] != e["freq"] else ""
        w("// 0x%s %s arity=%d table_mode=%s%s - %s%s"
          % (a, e["name"], e["arity"] or 0, e["mode"], (" role=" + e["role"]) if e["role"] else "", note, e["freq"]))
        w("REX_HOOK_RAW(%s) {" % sym)
        w("  constexpr std::size_t kIdx = %d;" % idx)
        w("  %s::detail::Hit(kIdx);" % ns)
        w("  switch (%s::EffectiveMode(kIdx)) {" % ns)
        w("    case Mode::kGuest:")
        w("      __imp__%s(ctx, base);" % sym)
        w("      break;")
        w("    case Mode::kTee:")
        w("      if (%s::hooks::TeePre_%s) %s::hooks::TeePre_%s(ctx, base);" % (ns, a, ns, a))
        w("      __imp__%s(ctx, base);" % sym)
        w("      if (%s::hooks::TeePost_%s) %s::hooks::TeePost_%s(ctx, base);" % (ns, a, ns, a))
        w("      break;")
        w("    case Mode::kNative:")
        w("      if (!%s::hooks::Native_%s)" % (ns, a))
        w('        %s::detail::Fatal(kIdx, static_cast<uint32_t>(ctx.lr), "native mode without a bound Native_ hook");' % ns)
        w("      %s::hooks::Native_%s(ctx, base);" % (ns, a))
        w("      break;")
        w("    case Mode::kFatal:")
        w('      %s::detail::Fatal(kIdx, static_cast<uint32_t>(ctx.lr), "guest function reached in native mode");' % ns)
        w("  }")
        if e["role"] == "present":
            w("  %s::detail::OnPresent();" % ns)
        elif e["role"] == "ring_init":
            w("  %s::detail::OnRingInit(ctx.r3.u32, ctx.r4.u32);" % ns)
        w("}")
        w("")
    return "\n".join(L) + "\n"


def snapshot_macro_available():
    hdr = os.path.join(SDK_DIR, "include", "rex", "system", "snapshot.h")
    if not os.path.exists(hdr):
        return False
    with open(hdr, errors="ignore") as fh:
        return "define REX_SNAP_HOOK" in fh.read()


def gen_record_cpp(ing, lib, entries, have_macro):
    ns = lib + "native"
    L = []
    w = L.append
    w("// GENERATED FILE - DO NOT EDIT.")
    w("// Written by `rexnative emit` (--lib %s). Snapshot-recording wrappers for" % lib)
    w("// every entry in api_table.toml.")
    w("//")
    w("// MUTUALLY EXCLUSIVE with gen/overrides.cpp: both define the strong sub_X")
    w("// symbols. sources.cmake picks this file when %s_%sNATIVE_RECORD=ON;" % (ing["title"].upper(), lib.upper()))
    w("// build that configuration, run with REX_SNAP_DIR=<dir> to record one .snap")
    w("// per call (REX_SNAP_MAX per address), then replay with tests/native/snap_replay")
    w("// against the native implementation.")
    w("//")
    w("// Ranges: registers only by default. Add argument-pointed ranges once the")
    w("// entry's layout is known, e.g.")
    w("//   REX_SNAP_HOOK(sub_8269ADD8, {ctx.r4.u32, 64}, {ctx.r5.u32, ctx.r6.u32 * 4})")
    w("// Put such per-entry ranges in ../snap_ranges.h (macro %s_SNAP_RANGES_<ADDR>)" % lib.upper())
    w("// and they survive regeneration.")
    w("")
    w("#include <cstdint>")
    w("")
    w("#include <rex/hook.h>")
    w("#if __has_include(<rex/system/snapshot.h>)")
    w("#include <rex/system/snapshot.h>")
    w("#endif")
    w("#if __has_include(\"%snative/snap_ranges.h\")" % lib)
    w('#include "%snative/snap_ranges.h"' % lib)
    w("#endif")
    w("")
    if not have_macro:
        w("// NOTE: the SDK this was generated against had no REX_SNAP_HOOK yet")
        w("// (workstream B2, src/system/snapshot.cpp). The placeholder below keeps the")
        w("// file compiling as a plain forwarding wrapper; regenerate once B2 lands.")
        w("")
    w("#ifdef REX_SNAP_HOOK")
    w("#define %s_SNAP(sub, addr, ...) REX_SNAP_HOOK(sub __VA_OPT__(,) __VA_ARGS__)" % lib.upper())
    w("#else")
    w("// Placeholder: forward only, so the record configuration still links.")
    w("#define %s_SNAP(sub, addr, ...)              \\" % lib.upper())
    w("  REX_EXTERN(__imp__##sub);                  \\")
    w("  extern \"C\" REX_FUNC(sub) { __imp__##sub(ctx, base); }")
    w("#endif")
    w("")
    w("namespace %s::record {" % ns)
    w("struct RecordEntry { uint32_t address; const char* name; uint8_t arity; };")
    w("const RecordEntry kRecordEntries[] = {")
    for e in entries:
        w("    {0x%08X, %s, %d}," % (e["address"], cpp_str(e["name"]), e["arity"] or 0))
    w("};")
    w("const std::size_t kRecordEntryCount = %d;" % len(entries))
    w("}  // namespace %s::record" % ns)
    w("")
    for e in entries:
        a = "%08X" % e["address"]
        w("// 0x%s %s arity=%d - %s" % (a, e["name"], e["arity"] or 0, e["freq"]))
        w("#ifdef %s_SNAP_RANGES_%s" % (lib.upper(), a))
        w("%s_SNAP(sub_%s, 0x%s, %s_SNAP_RANGES_%s)" % (lib.upper(), a, a, lib.upper(), a))
        w("#else")
        w("%s_SNAP(sub_%s, 0x%s)" % (lib.upper(), a, a))
        w("#endif")
        w("")
    return "\n".join(L) + "\n"


def gen_native_h(ing, lib):
    ns = lib + "native"
    t = ing["title"]
    cv = "%s_%s" % (t, lib)
    return f"""// {ns}: mode switch and reach counters for the {t} {lib} band.
//
// Scaffold written once by `rexnative emit` (--lib {lib}); hand-owned after
// that (emit does not overwrite it without --force). The generated overrides
// in gen/overrides.cpp displace the weak generated sub_X symbols for every
// entry in api_table.toml. Each override counts the call, then acts on the
// entry's effective mode, which this module computes once at app post-setup
// from the cvars:
//
//   {cv} = guest | tee | native      global switch (default guest)
//   {cv}_entries = "ADDR=mode,..."  per-entry override, applied last
//   {cv}_log_counts (int seconds)    0 = only at exit; N = also every N s
//
// Native code binds to an entry by defining, in namespace {ns}::hooks,
// any of  TeePre_<ADDR>, TeePost_<ADDR>, Native_<ADDR>  with the PPCFunc
// signature (see README.md). The generated file declares them weak, so an
// entry without an implementation still links; Init() logs what is bound.

#pragma once

#include <atomic>
#include <cstddef>
#include <cstdint>

#include <rex/ppc/func.h>

namespace {ns} {{

enum class Mode : uint8_t {{ kGuest = 0, kTee = 1, kNative = 2, kFatal = 3 }};
enum class Role : uint8_t {{ kNone = 0, kPresent = 1, kRingInit = 2 }};

struct Entry {{
  uint32_t address;      // guest VA; symbol is sub_<address>
  const char* name;      // from api_table.toml
  uint8_t arity;         // integer args in r3.. (informational)
  Mode table_mode;       // what "native" means for this entry
  Role role;
  PPCFunc* imp;          // __imp__sub_<address>, the generated body
  PPCFunc* tee_pre;      // weak hooks, null when not implemented
  PPCFunc* tee_post;
  PPCFunc* native;
}};

// Generated tables (gen/overrides.cpp).
extern const Entry kEntries[];
extern const std::size_t kEntryCount;
extern std::atomic<uint64_t> g_counts[];
extern std::atomic<uint8_t> g_effective[];

bool ParseMode(const char* text, Mode& out);
const char* ModeName(Mode m);

// Read the cvars and compute every entry's effective mode. Call once from the
// app's OnPostSetup (after config parsing). Safe to call again; counters kept.
void Init();

// Log the reach table. Call from OnShutdown.
void Shutdown();

Mode GlobalMode();

inline Mode EffectiveMode(std::size_t index) {{
  return static_cast<Mode>(g_effective[index].load(std::memory_order_relaxed));
}}

uint64_t Count(std::size_t index);
uint64_t Count(const char* name);
uint64_t Count(uint32_t address);
std::size_t IndexOf(uint32_t address);

// Log "[{lib.upper()}NATIVE] band functions reached:" followed by one line per entry.
void LogCounts(const char* reason);

// Frames presented since start (incremented by the present-role override).
uint64_t FrameCount();

namespace detail {{
inline void Hit(std::size_t index) {{
  g_counts[index].fetch_add(1, std::memory_order_relaxed);
}}
void OnPresent();
void OnRingInit(uint32_t r3, uint32_t r4);
[[noreturn]] void Fatal(std::size_t index, uint32_t lr, const char* why);
}}  // namespace detail

}}  // namespace {ns}
"""


def gen_native_cpp(ing, lib):
    ns = lib + "native"
    t = ing["title"]
    cv = "%s_%s" % (t, lib)
    tag = "[%sNATIVE]" % lib.upper()
    return f"""// {ns}: cvars, effective-mode table and reach counters. See {lib}_native.h.
// Scaffold written once by `rexnative emit`; hand-owned after that.
#include "{ns}/{lib}_native.h"

#include <atomic>
#include <chrono>
#include <cstdlib>
#include <cstring>
#include <string>
#include <string_view>

#include <rex/cvar.h>
#include <rex/logging.h>
#include <rex/logging/assert.h>

REXCVAR_DEFINE_STRING({cv}, "guest", "{t}",
                      "{lib} band mode: guest (forward to recompiled code), tee (mirror into the "
                      "native implementation, then forward), native (per-entry mode from api_table.toml)");
REXCVAR_DEFINE_STRING({cv}_entries, "", "{t}",
                      "Per-entry mode overrides applied after {cv}, e.g. "
                      "\\"82695BE0=tee,Present=native\\" (address or table name)");
REXCVAR_DEFINE_INT32({cv}_log_counts, 0, "{t}",
                     "Log the band reach table every N seconds (0 = only at exit)");

namespace {ns} {{
namespace {{

Mode g_global_mode = Mode::kGuest;
std::atomic<uint64_t> g_frames{{0}};
std::atomic<bool> g_initialised{{false}};
std::atomic<int> g_log_every_s{{0}};
std::chrono::steady_clock::time_point g_last_log{{}};

std::size_t FindByNameOrAddress(std::string_view key) {{
  for (std::size_t i = 0; i < kEntryCount; ++i)
    if (key == kEntries[i].name) return i;
  std::string k(key);
  if (k.rfind("sub_", 0) == 0) k = k.substr(4);
  if (k.rfind("0x", 0) == 0 || k.rfind("0X", 0) == 0) k = k.substr(2);
  char* end = nullptr;
  unsigned long v = std::strtoul(k.c_str(), &end, 16);
  if (end && *end == '\\0' && !k.empty()) return IndexOf(static_cast<uint32_t>(v));
  return kEntryCount;
}}

void ApplyEntryOverrides(const std::string& spec) {{
  std::string_view s(spec);
  while (!s.empty()) {{
    auto comma = s.find(',');
    std::string_view item = s.substr(0, comma);
    s = comma == std::string_view::npos ? std::string_view{{}} : s.substr(comma + 1);
    while (!item.empty() && item.front() == ' ') item.remove_prefix(1);
    while (!item.empty() && item.back() == ' ') item.remove_suffix(1);
    if (item.empty()) continue;
    auto eq = item.find('=');
    if (eq == std::string_view::npos) {{
      REXLOG_WARN("{tag} {cv}_entries: ignoring '{{}}' (expected NAME=mode)", item);
      continue;
    }}
    std::size_t idx = FindByNameOrAddress(item.substr(0, eq));
    Mode m;
    if (idx == kEntryCount) {{
      REXLOG_WARN("{tag} {cv}_entries: unknown entry '{{}}'", item.substr(0, eq));
      continue;
    }}
    if (!ParseMode(std::string(item.substr(eq + 1)).c_str(), m)) {{
      REXLOG_WARN("{tag} {cv}_entries: bad mode in '{{}}'", item);
      continue;
    }}
    g_effective[idx].store(static_cast<uint8_t>(m), std::memory_order_relaxed);
  }}
}}

}}  // namespace

bool ParseMode(const char* text, Mode& out) {{
  if (!text) return false;
  if (!std::strcmp(text, "guest")) {{ out = Mode::kGuest; return true; }}
  if (!std::strcmp(text, "tee")) {{ out = Mode::kTee; return true; }}
  if (!std::strcmp(text, "native")) {{ out = Mode::kNative; return true; }}
  if (!std::strcmp(text, "fatal")) {{ out = Mode::kFatal; return true; }}
  return false;
}}

const char* ModeName(Mode m) {{
  switch (m) {{
    case Mode::kGuest: return "guest";
    case Mode::kTee: return "tee";
    case Mode::kNative: return "native";
    case Mode::kFatal: return "fatal";
  }}
  return "?";
}}

Mode GlobalMode() {{ return g_global_mode; }}
uint64_t FrameCount() {{ return g_frames.load(std::memory_order_relaxed); }}

std::size_t IndexOf(uint32_t address) {{
  for (std::size_t i = 0; i < kEntryCount; ++i)
    if (kEntries[i].address == address) return i;
  return kEntryCount;
}}

uint64_t Count(std::size_t index) {{
  return index < kEntryCount ? g_counts[index].load(std::memory_order_relaxed) : 0;
}}
uint64_t Count(const char* name) {{ return Count(name ? FindByNameOrAddress(name) : kEntryCount); }}
uint64_t Count(uint32_t address) {{ return Count(IndexOf(address)); }}

void Init() {{
  const std::string& mode_text = REXCVAR_GET({cv});
  if (!ParseMode(mode_text.c_str(), g_global_mode)) {{
    REXLOG_WARN("{tag} {cv}='{{}}' is not guest|tee|native; using guest", mode_text);
    g_global_mode = Mode::kGuest;
  }}
  if (g_global_mode == Mode::kFatal) {{
    REXLOG_WARN("{tag} {cv}=fatal is not a global mode; using native");
    g_global_mode = Mode::kNative;
  }}
  for (std::size_t i = 0; i < kEntryCount; ++i) {{
    Mode eff;
    switch (g_global_mode) {{
      case Mode::kGuest: eff = Mode::kGuest; break;
      case Mode::kTee: eff = Mode::kTee; break;
      default: eff = kEntries[i].table_mode; break;
    }}
    g_effective[i].store(static_cast<uint8_t>(eff), std::memory_order_relaxed);
  }}
  ApplyEntryOverrides(REXCVAR_GET({cv}_entries));
  g_log_every_s.store(REXCVAR_GET({cv}_log_counts), std::memory_order_relaxed);
  g_last_log = std::chrono::steady_clock::now();
  g_initialised.store(true, std::memory_order_release);

  REXLOG_INFO("{tag} mode={{}} entries={{}} log_counts={{}}s", ModeName(g_global_mode), kEntryCount,
              g_log_every_s.load());
  for (std::size_t i = 0; i < kEntryCount; ++i) {{
    const Entry& e = kEntries[i];
    Mode eff = EffectiveMode(i);
    if (eff == Mode::kNative && !e.native)
      REXLOG_WARN("{tag}   {{:08X}} {{:<28}} effective=native but hooks::Native_{{:08X}} is not bound; "
                  "the first call will be fatal", e.address, e.name, e.address);
    REXLOG_INFO("{tag}   {{:08X}} {{:<28}} table={{:<6}} effective={{:<6}} bound:{{}}{{}}{{}}", e.address, e.name,
                ModeName(e.table_mode), ModeName(eff), e.tee_pre ? " tee_pre" : "",
                e.tee_post ? " tee_post" : "", e.native ? " native" : "");
  }}
}}

void LogCounts(const char* reason) {{
  REXLOG_INFO("{tag} band functions reached ({{}}), frames={{}}:", reason ? reason : "",
              g_frames.load(std::memory_order_relaxed));
  REXLOG_INFO("{tag}   {{:<8}} {{:<28}} {{:<6}} {{:>12}}", "address", "name", "mode", "count");
  for (std::size_t i = 0; i < kEntryCount; ++i) {{
    const Entry& e = kEntries[i];
    REXLOG_INFO("{tag}   {{:08X}} {{:<28}} {{:<6}} {{:>12}}", e.address, e.name, ModeName(EffectiveMode(i)),
                g_counts[i].load(std::memory_order_relaxed));
  }}
}}

void Shutdown() {{
  if (!g_initialised.exchange(false)) return;
  LogCounts("exit");
}}

namespace detail {{

void OnPresent() {{
  g_frames.fetch_add(1, std::memory_order_relaxed);
  int every = g_log_every_s.load(std::memory_order_relaxed);
  if (every <= 0) return;
  auto now = std::chrono::steady_clock::now();
  if (now - g_last_log >= std::chrono::seconds(every)) {{
    g_last_log = now;
    LogCounts("periodic");
  }}
}}

void OnRingInit(uint32_t r3, uint32_t r4) {{
  REXLOG_INFO("{tag} ring init r3={{:08X}} r4={{:08X}} mode={{}}", r3, r4, ModeName(g_global_mode));
}}

void Fatal(std::size_t index, uint32_t lr, const char* why) {{
  const Entry& e = kEntries[index];
  LogCounts("fatal");
  REX_FATAL("{tag} {{}}: {{:08X}} {{}} (lr={{:08X}}, table={{}}, effective={{}})", why, e.address, e.name, lr,
            ModeName(e.table_mode), ModeName(EffectiveMode(index)));
}}

}}  // namespace detail
}}  // namespace {ns}
"""


