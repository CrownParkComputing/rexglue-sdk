def run_step(cmd, cwd=None, timeout=1800):
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout + p.stderr).strip()
    except FileNotFoundError as exc:
        return None, str(exc)
    except subprocess.TimeoutExpired:
        return None, "timeout after %ds" % timeout


def tail(text, n=12):
    lines = text.splitlines()
    return "\n".join(lines[-n:])


def cmd_verify(args):
    """Run every gate that exists and record the result block.

    native_check.py (B1), tests/native/snap_replay (B2) and tools/tee_diff.py
    (B2) are other workstreams' tools: each is run only if present, and a
    missing one is reported as SKIPPED, never as PASS. The block goes to
    NATIVE_COVERAGE.md via native_report.py when that tool can append, else to
    PORT/src/<lib>native/VERIFY.md.
    """
    import datetime
    ing = load_ingest(args.ingest)
    lib = lib_of(args)
    port, title = ing["port"], ing["title"]
    lib_dir = os.path.join(port, "src", "%snative" % lib)
    tools = os.path.join(SDK_DIR, "tools")
    results = []   # (name, status, detail)

    def add(name, status, detail=""):
        results.append((name, status, detail))
        print("  %-14s %-8s %s" % (name, status, detail.splitlines()[0] if detail else ""))

    print("== rexnative verify: %s / %s ==" % (ing["slug"], lib))
    modules = load_native_toml(port)
    if lib not in modules:
        add("native.toml", "FAIL", "no [module.%s] - run `rexnative emit`" % lib)
    else:
        add("native.toml", "ok", "policy %s ranges %s" % (modules[lib].get("policy"), modules[lib].get("ranges")))

    # 1. native_check.py
    nc = os.path.join(tools, "native_check.py")
    if os.path.exists(nc):
        cmd = [sys.executable, nc, port, "--module", lib]
        reach = find_reach(args, port)
        if reach:
            cmd += ["--reach", reach]
        rc, out = run_step(cmd)
        add("native_check", "PASS" if rc == 0 else ("SKIPPED" if rc is None else "FAIL"), tail(out))
    else:
        add("native_check", "SKIPPED", "tools/native_check.py not present (B1)")

    # 2. snap_replay
    snap_bin = None
    for pat in (os.path.join(SDK_DIR, "out", "build", "*", "tests", "native", "snap_replay"),
                os.path.join(SDK_DIR, "build*", "tests", "native", "snap_replay"),
                os.path.join(port, "out", "build", "*", "snap_replay")):
        hits = [p for p in glob.glob(pat) if os.access(p, os.X_OK)]
        if hits:
            snap_bin = hits[0]
            break
    snap_dir = args.snap_dir or os.environ.get("REX_SNAP_DIR") or os.path.join(port, "out", "native", "snap")
    snaps = glob.glob(os.path.join(snap_dir, "*.snap")) if os.path.isdir(snap_dir) else []
    if snap_bin and snaps:
        rc, out = run_step([snap_bin, snap_dir] + (["--module", lib] if args.snap_module_flag else []))
        add("snap_replay", "PASS" if rc == 0 else "FAIL", "%d snapshots in %s\n%s" % (len(snaps), snap_dir, tail(out)))
    elif snap_bin:
        add("snap_replay", "SKIPPED", "no .snap files in %s (record build: REX_SNAP_DIR)" % snap_dir)
    else:
        add("snap_replay", "SKIPPED", "tests/native/snap_replay not built (B2)")

    # 3. tee_diff.py
    td = os.path.join(tools, "tee_diff.py")
    tee_a, tee_b = args.tee_a, args.tee_b
    if not (tee_a and tee_b):
        logs = sorted(glob.glob(os.path.join(port, "out", "native", "tee_*.txt")) +
                      glob.glob(os.path.join(port, "out", "native", "tee_*.csv")))
        if len(logs) >= 2:
            tee_a, tee_b = logs[-2], logs[-1]
    if os.path.exists(td) and tee_a and tee_b:
        rc, out = run_step([sys.executable, td, tee_a, tee_b])
        add("tee_diff", "PASS" if rc == 0 else "FAIL", "%s vs %s\n%s" % (tee_a, tee_b, tail(out)))
    elif os.path.exists(td):
        add("tee_diff", "SKIPPED", "no tee logs (--tee-a/--tee-b or out/native/tee_*.txt)")
    else:
        add("tee_diff", "SKIPPED", "tools/tee_diff.py not present (B2)")

    # 4. coverage line
    reach = find_reach(args, port)
    counts = read_reach(reach) if reach else {}
    symbols = load_symbols(port)
    cov = None
    if lib in modules:
        cov = module_coverage(port, lib, modules[lib], symbols, counts)
        add("coverage", "ok", coverage_line(cov).strip())

    overall = "FAIL" if any(s == "FAIL" for _, s, _ in results) else \
              ("PASS" if any(s == "PASS" for _, s, _ in results) else "INCOMPLETE")
    stamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    block = ["## rexnative verify: %s / %s - %s (%s)" % (title, lib, overall, stamp), "",
             "| gate | result | detail |", "|---|---|---|"]
    for name, status, detail in results:
        d = detail.replace("|", "\\|").replace("\n", "<br>")
        block.append("| %s | %s | %s |" % (name, status, d))
    block.append("")
    block_text = "\n".join(block) + "\n"

    # 5. where to put it: native_report.py --append if B1 added that, else VERIFY.md.
    nr = os.path.join(tools, "native_report.py")
    report_path = None
    if os.path.exists(nr):
        rc, helptext = run_step([sys.executable, nr, "--help"])
        if rc == 0 and "--append" in helptext:
            tmp = os.path.join(port, "out", "rexnative", "verify_block_%s.md" % lib)
            os.makedirs(os.path.dirname(tmp), exist_ok=True)
            with open(tmp, "w") as fh:
                fh.write(block_text)
            rc, out = run_step([sys.executable, nr, port, "--append", tmp])
            if rc == 0:
                report_path = os.path.join(port, "NATIVE_COVERAGE.md")
    if report_path is None:
        os.makedirs(lib_dir, exist_ok=True)
        report_path = os.path.join(lib_dir, "VERIFY.md")
        prev = open(report_path).read() if os.path.exists(report_path) else \
            "# %s / %s verification log\n\nAppended by `rexnative verify`; newest block last.\n\n" % (title, lib)
        with open(report_path, "w") as fh:
            fh.write(prev + block_text)

    ing.setdefault("verify", {})[lib] = {"result": overall, "report": report_path, "when": stamp}
    save_ingest(ing)
    print("  overall        %s" % overall)
    print("  -> %s" % report_path)
    return 0 if overall != "FAIL" else 1


