def splice_toml_section(existing_text, lib, fields):
    """Merge [module.<lib>]: an existing table keeps every key it has (B1 owns
    the shape; A1 may point `band`/`entrypoints` at docs/) and only gains the
    keys it lacks; a missing table is appended in full. Returns (text, added)."""
    hdr = "[module.%s]" % lib
    lines = existing_text.splitlines(keepends=True) if existing_text else []
    start = None
    for i, l in enumerate(lines):
        if l.strip() == hdr:
            start = i
            break
    if start is None:
        head = existing_text if existing_text else (
            "# native.toml - module ranges and gate policy (docs/native/FORMATS.md).\n"
            "# Written by `rexnative emit`; one [module.<lib>] table per library.\n"
            "format = \"rex-native-toml/1\"\n\n")
        if not head.endswith("\n"):
            head += "\n"
        if not head.endswith("\n\n"):
            head += "\n"
        body = hdr + "\n" + "".join("%s = %s\n" % kv for kv in fields.items())
        return head + body, list(fields)
    end = len(lines)
    for j in range(start + 1, len(lines)):
        if lines[j].lstrip().startswith("["):
            end = j
            break
    present = set()
    for l in lines[start + 1:end]:
        m = re.match(r"\s*([A-Za-z0-9_\-]+)\s*=", l)
        if m:
            present.add(m.group(1))
    added = [k for k in fields if k not in present]
    # insert before trailing blank lines of the section
    ins = end
    while ins > start + 1 and not lines[ins - 1].strip():
        ins -= 1
    new = lines[:ins] + ["%s = %s\n" % (k, fields[k]) for k in added] + lines[ins:]
    return "".join(new), added


def diff_summary(new_text, old_path, label, max_lines=40):
    if not os.path.exists(old_path):
        return ["  %-22s NEW (no existing file to compare)" % label]
    old = open(old_path, errors="ignore").read()
    if old == new_text:
        return ["  %-22s identical to %s" % (label, old_path)]
    ol, nl = old.splitlines(), new_text.splitlines()
    sm = difflib.SequenceMatcher(None, ol, nl)
    add = sum(j2 - j1 for tag, i1, i2, j1, j2 in sm.get_opcodes() if tag in ("insert", "replace"))
    rem = sum(i2 - i1 for tag, i1, i2, j1, j2 in sm.get_opcodes() if tag in ("delete", "replace"))
    out = ["  %-22s differs from %s: +%d -%d lines (of %d old / %d new)" % (label, old_path, add, rem, len(ol), len(nl))]
    for line in list(difflib.unified_diff(ol, nl, "existing", "emitted", lineterm="", n=0))[2:2 + max_lines]:
        out.append("      " + line)
    return out


def cmd_emit(args):
    """Generate the seam scaffolding for one library on a port.

    The library is not recompiled away - its entry points get strong hooks
    that displace the weak aliases codegen emits, and each hook forwards to
    the generated body until the entry's mode says otherwise. Every entry
    starts as guest-forwarding with its measured frequency in a comment, so
    the order to implement is the order that gets a frame on screen soonest.
    Nothing under generated/ is touched.
    """
    ing = load_ingest(args.ingest)
    lib = lib_of(args)
    port = ing["port"]
    title = ing["title"]

    # Counts: explicit --reach/--counts, else the csv the harvest recorded.
    hv = ing.get("harvest", {}).get(lib, {})
    reach = args.reach or (hv.get("reach") if not args.counts else None)
    counts, src = load_counts(reach, args.counts)
    region_override = None
    if args.region:
        region_override = parse_range(args.region)
    elif hv.get("region"):
        region_override = tuple(int(x, 16) for x in hv["region"].split(".."))
    h = harvest_core(ing, lib, args.pad, counts, region_override)
    h["reach"] = os.path.abspath(src) if src else None
    lo, hi = h["_region"]

    lib_dir_rel = "src/%snative" % lib
    real_dir = os.path.join(port, lib_dir_rel)
    dry_root = os.path.join(port, "out", "rexnative", "dry", lib)
    out_dir = args.out_dir or (os.path.join(dry_root, lib_dir_rel) if args.dry_run else real_dir)

    # A1 names / arity.
    ep_path = args.entrypoints
    if ep_path is None:
        cand = os.path.join(port, "docs", lib.replace("d3d9", "d3d"), "entrypoints.json")
        ep_path = cand if os.path.exists(cand) else None
    names_by_addr = load_entrypoint_names(ep_path) if ep_path else {}
    ar_path = args.arity
    if ar_path is None:
        cand = os.path.join(port, "docs", lib.replace("d3d9", "d3d"), "arity.json")
        ar_path = cand if os.path.exists(cand) else None
    arity_by_addr = load_arity_file(ar_path) if ar_path else {}

    # Module range for native.toml: explicit --range, else what native.toml
    # already says (B1/A1 own that), else the 64 KiB-aligned hull of the seeds.
    # The harvest pad is only an instrumentation bound; entries are selected
    # inside the module range so game code next to the library is not hooked.
    nt_path = os.path.join(port, "native.toml")
    nt_old = open(nt_path).read() if os.path.exists(nt_path) else ""
    nt_mod = load_native_toml(port).get(lib, {})
    range_src = "--range"
    if args.range:
        mranges = [parse_range(args.range)]
    elif nt_mod.get("ranges") or nt_mod.get("range"):
        mranges = [parse_range(r) for r in (nt_mod.get("ranges") or [nt_mod["range"]])]
        range_src = "native.toml"
    else:
        slo, shi = (int(x, 16) for x in h["seed_span"].split("-"))
        mranges = [(slo & ~0xFFFF, shi | 0xFFFF)]
        range_src = "seed hull"
    ranges = ["%08X-%08X" % r for r in mranges]

    meta_prev, existing = load_existing_table(os.path.join(real_dir, "api_table.toml"))
    entries, measured = select_entries(ing, lib, h, args, names_by_addr, arity_by_addr, existing, mranges)
    if not entries:
        sys.exit("no entries selected - was the harvest run long enough? (try --include-internal or --pick)")
    need = [e["address"] for e in entries if e["arity"] is None]
    if need:
        est = estimate_arity(ing, need)
        for e in entries:
            if e["arity"] is None:
                e["arity"] = est.get(e["address"])

    banned = sorted(e["address"] for e in entries if e["mode"] == "fatal")

    have_macro = snapshot_macro_available()
    table_rel = lib_dir_rel + "/api_table.toml"
    files = {
        "api_table.toml": gen_api_table(ing, lib, entries, (lo, hi), meta_prev),
        "entrypoints.json": gen_entrypoints_json(ing, lib, entries, h, measured),
        "gen/overrides.cpp": gen_overrides_cpp(ing, lib, entries, table_rel),
