def cmd_link(args):
    ing = load_ingest(args.ingest)
    lib = lib_of(args)
    port, title = ing["port"], ing["title"]
    lib_dir_rel = "src/%snative" % lib
    lib_dir = os.path.join(port, lib_dir_rel)
    if not os.path.exists(os.path.join(lib_dir, "gen", "overrides.cpp")):
        sys.exit("no %s/gen/overrides.cpp - run `rexnative emit` first" % lib_dir)
    T, L = title.upper(), lib.upper()
    opt_record = "%s_%sNATIVE_RECORD" % (T, L)
    text = f"""# GENERATED by `rexnative link` ({title} / {lib}) - do not edit.
#
# include() this from the port's CMakeLists.txt AFTER rexglue_setup_target({title}):
#     include(${{CMAKE_CURRENT_SOURCE_DIR}}/{lib_dir_rel}/sources.cmake)
# It adds the {lib}native sources to the {title} target, exposes the record
# configuration, and wires the Stage 0 reach counters (docs/native/FORMATS.md).

if(NOT TARGET {title})
    message(FATAL_ERROR "{lib_dir_rel}/sources.cmake: include it after add_executable({title}) / rexglue_setup_target({title})")
endif()

option({opt_record} "Build {lib_dir_rel}/gen/record.cpp (REX_SNAP_HOOK wrappers) instead of gen/overrides.cpp" OFF)
if(NOT DEFINED REXGLUE_GUEST_REACH)
    option(REXGLUE_GUEST_REACH "Count calls to every generated guest function (REX_TRACE_REACH)" OFF)
endif()

set({T}_{L}NATIVE_SOURCES
    ${{CMAKE_CURRENT_LIST_DIR}}/{lib}_native.cpp
)
if({opt_record})
    list(APPEND {T}_{L}NATIVE_SOURCES ${{CMAKE_CURRENT_LIST_DIR}}/gen/record.cpp)
else()
    list(APPEND {T}_{L}NATIVE_SOURCES ${{CMAKE_CURRENT_LIST_DIR}}/gen/overrides.cpp)
endif()

target_sources({title} PRIVATE ${{{T}_{L}NATIVE_SOURCES}})
target_include_directories({title} PRIVATE ${{CMAKE_CURRENT_LIST_DIR}}/..)

if(REXGLUE_GUEST_REACH AND TARGET {title}_recomp)
    target_compile_definitions({title}_recomp PRIVATE REX_GUEST_REACH=1)
endif()
"""
    dest = os.path.join(lib_dir, "sources.cmake")
    with open(dest, "w") as fh:
        fh.write(text)
    include_line = "include(${CMAKE_CURRENT_SOURCE_DIR}/%s/sources.cmake)" % lib_dir_rel

    cml = os.path.join(port, "CMakeLists.txt")
    cml_text = open(cml).read() if os.path.exists(cml) else ""
    already = include_line in cml_text or ("%s/sources.cmake" % lib_dir_rel) in cml_text
    marker = "# rexnative:link"
    edited = False
    if not already and marker in cml_text and not args.no_edit:
        lines = cml_text.splitlines(keepends=True)
        for i, l in enumerate(lines):
            if l.strip() == marker:
                lines.insert(i + 1, include_line + "\n")
                edited = True
                break
        if edited:
            with open(cml, "w") as fh:
                fh.write("".join(lines))

    # Collisions with an existing hand layout (A2's PGR4 d3d9native).
    warnings = []
    for rel in ("gen/band_overrides.cpp", "mode.cpp"):
        if rel in cml_text and lib == "d3d9":
            warnings.append("CMakeLists already lists %s/%s: it defines the same strong sub_X / cvars as the "
                            "emitted files - link one layout, not both" % (lib_dir_rel, rel))

    ing.setdefault("link", {})[lib] = {"sources_cmake": dest, "include": include_line, "cmake_edited": edited}
    save_ingest(ing)

    print("== rexnative link: %s / %s ==" % (ing["slug"], lib))
    print("  -> %s" % dest)
    if already:
        print("  CMakeLists.txt     already includes it")
    elif edited:
        print("  CMakeLists.txt     include inserted after the '%s' marker" % marker)
    else:
        print("  add this line to %s after rexglue_setup_target(%s):" % (cml, title))
        print()
        print("    " + include_line)
        print()
        print("  (or put a '%s' comment line there and rerun link to insert it)" % marker)
    print("  then call %snative::Init() in OnPostSetup and %snative::Shutdown() in OnShutdown." % (lib, lib))
    print("  reach build:       cmake -DREXGLUE_GUEST_REACH=ON ...; run with REX_TRACE_REACH=<csv>")
    print("  record build:      cmake -D%s=ON ...; run with REX_SNAP_DIR=<dir>" % opt_record)
    for wmsg in warnings:
        print("  warning: " + wmsg)
    return 0


