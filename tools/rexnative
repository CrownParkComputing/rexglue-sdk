def harvest_core(ing, lib, pad, counts, region_override=None):
    """Bound the library and attribute counts to it. Pure; no files written."""
    sub = ing["middleware"].get(lib)
    if not sub or not sub["seed_functions"]:
        sys.exit("no %s seeds in %s" % (lib, ing["_path"]))
    seeds = [int(x, 16) for x in sub["seed_functions"]]
    if region_override:
        lo, hi = region_override
    else:
        lo, hi = min(seeds) - pad, max(seeds) + pad

    ppc_dir = ing.get("ppc_dir") or os.path.join(ing["port"], "ppc")
    funcs, calls, _, imports = scan_recompiled(ppc_dir, os.path.join(ing["port"], "out", "rexnative"))
    region = sorted(f for f in funcs if lo <= f <= hi)
    if not region:
        sys.exit("candidate region is empty")
    inset = set(region)
    rev = callers_of(calls)

    # Frame count: the role anchor (VdSwap caller) is called once per present.
    anchors = {}
    for role, imp in ROLE_IMPORTS.get(lib, {}).items():
        anchors[role] = sorted(f for f in region if imp in imports.get(f, ()))
    frames = None
    if counts and anchors.get("present"):
        frames = max(counts.get(f, 0) for f in anchors["present"]) or None

    # Static ring classification: reaches (within the region) a function that
    # calls a ring import. An UNDER-approximation for PM4 writers (ordinary
    # stores); the checksum attribution needs the counter TU (--emit-counters).
    memo = {}

    def reaches_ring(f, stack=()):
        if f in memo:
            return memo[f]
        if f in stack:
            return False
        if imports.get(f, set()) & RING_IMPORTS:
            memo[f] = True
            return True
        r = any(reaches_ring(c, stack + (f,)) for c in calls.get(f, ()) if c in inset)
        memo[f] = r
        return r

    rows = []
    for f in region:
        outside = sorted(rev.get(f, set()) - inset)
        n = counts.get(f, 0)
        rows.append({
            "addr": "%08X" % f,
            "count": n,
            "band": band_of(n, frames) if counts else "unmeasured",
            "entry": bool(outside),
            "callers_outside": ["%08X" % c for c in outside[:32]],
            "callers_outside_count": len(outside),
            "imports": sorted(imports.get(f, ())),
            "reaches_ring_import": reaches_ring(f),
            "roles": [role for role, fs in anchors.items() if f in fs],
        })
    reached = [r for r in rows if r["count"] > 0]
    return {
        "format": "rex-native-harvest/1",
        "lib": lib,
        "title": ing["title"],
        "region": "%08X-%08X" % (lo, hi),
        "seed_span": "%08X-%08X" % (min(seeds), max(seeds)),
        "seeds": len(seeds),
        "frames": frames,
        "functions": rows,
        "summary": {
            "in_region": len(rows),
            "api_candidates": sum(1 for r in rows if r["entry"]),
            "reached": len(reached),
            "reached_api_candidates": sum(1 for r in reached if r["entry"]),
            "calls_total": sum(r["count"] for r in rows),
            "ring_candidates": sum(1 for r in rows if r["reaches_ring_import"]),
        },
        "_region": (lo, hi), "_calls": calls, "_rev": rev, "_inset": inset, "_imports": imports,
    }


def parse_range(text):
    m = re.fullmatch(r"(?:0x)?([0-9A-Fa-f]{8})\s*[-.]+\s*(?:0x)?([0-9A-Fa-f]{8})", text.strip())
    if not m:
        sys.exit("range must look like 82690000-8269FFFF, got %r" % text)
    return int(m.group(1), 16), int(m.group(2), 16)


def write_counter_tu(dest, lib, lo, hi, region, entry, args):
    """Legacy instrumentation TU (pre Stage 0). Kept for ports whose generated
    code is not built with REX_GUEST_REACH, and for --attribute-ring's ring
    checksum, which needs code around each call and cannot come from a csv."""
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    with open(dest, "w") as fh:
        w = lambda s="": print(s, file=fh)
        w("// GENERATED by `rexnative harvest --emit-counters` - do not edit.")
        w("//")
        w("// A call counter on every function in the %s candidate region" % lib)
        w("// 0x%08X..0x%08X - %d functions, %d of them called from outside it."
          % (lo, hi, len(region), len(entry)))
        w("//")
        w("// Superseded for plain counting by the reach trace (-DREX_GUEST_REACH,")
        w("// REX_TRACE_REACH=<csv>); still the only source of ring attribution.")
        w("//")
        w("// Hooked through the weak-alias seam: defining the unprefixed name wins")
        w("// at link and __imp__ still reaches the original.")
        w('#include "guest.h"')
        w("#include <atomic>")
        w("#include <cstdio>")
        w("#include <algorithm>")
        w("#include <vector>")
        w("#include <utility>")
        w("#include <functional>")
        w()
        w("namespace {")
        w("struct Counter {")
        w("    unsigned addr;")
        w("    std::atomic<unsigned long long> n{0};")
        w("    std::atomic<bool> wrote_ring{false};")
        w("};")
        w("Counter g_counters[] = {")
        for f in region:
            w("    {0x%08Xu}," % f)
        w("};")
        w("constexpr size_t kCount = sizeof(g_counters) / sizeof(g_counters[0]);")
        if args.attribute_ring:
            w("// Which functions actually WRITE the command buffer.")
            w("//")
            w("// Static analysis cannot answer this. PM4 goes into the ring through")
            w("// ordinary stores, so neither a Vd* import scan nor an MMIO scan sees")
            w("// it. So checksum the ring around every call and attribute the change.")
            w("// The window has to cover the INDIRECT BUFFERS, not just the ring, and")
            w("// is strided because this runs on every call of a per-draw function.")
            w("uint32_t RingChecksum() {")
            w("    const uint32_t base_addr = RingBase();")
            w("    if (!base_addr) return 0;")
            w("    constexpr uint32_t kWindowBytes = %d;" % args.watch_bytes)
            w("    constexpr uint32_t kStride = %d;" % args.watch_stride)
            w("    uint32_t h = 2166136261u;")
            w("    for (uint32_t off = 0; off < kWindowBytes; off += 4u * kStride) {")
            w("        h = (h ^ gst_r32(base_addr + off)) * 16777619u;")
            w("    }")
            w("    return h;")
            w("}")
            w()
        w("}  // namespace")
        w()
        for i, f in enumerate(region):
            w('extern "C" void __imp__sub_%08X(PPCContext&, uint8_t*);' % f)
            w("void sub_%08X(PPCContext& ctx, uint8_t* base) {" % f)
            w("    g_counters[%d].n.fetch_add(1, std::memory_order_relaxed);" % i)
            if args.attribute_ring:
                w("    const uint32_t before_%d = RingChecksum();" % i)
                w("    __imp__sub_%08X(ctx, base);" % f)
                w("    if (RingChecksum() != before_%d)" % i)
                w("        g_counters[%d].wrote_ring.store(true, std::memory_order_relaxed);" % i)
            else:
                w("    __imp__sub_%08X(ctx, base);" % f)
            w("}")
        w()
        w('extern "C" void rexnative_harvest_report() {')
        w("    std::vector<std::pair<unsigned long long, unsigned>> live;")
        w("    for (size_t i = 0; i < kCount; ++i) {")
        w("        unsigned long long n = g_counters[i].n.load();")
        w("        if (n) live.emplace_back(n, g_counters[i].addr);")
        w("    }")
        w("    std::sort(live.begin(), live.end(), std::greater<>());")
        w('    fprintf(stderr, "\\n[harvest] %s: %%zu of %%zu functions called\\n", live.size(), kCount);' % lib)
        if args.attribute_ring:
            w('    fprintf(stderr, "[harvest] functions that WROTE the command buffer:\\n");')
            w("    for (size_t i = 0; i < kCount; ++i) {")
            w("        if (!g_counters[i].wrote_ring.load()) continue;")
            w('        fprintf(stderr, "  sub_%08X %10llu calls  SUBMITS\\n",')
            w("                g_counters[i].addr,")
            w("                (unsigned long long)g_counters[i].n.load());")
            w("    }")
        w("    for (const auto& e : live) {")
        w("        unsigned long long n = e.first;")
        w('        const char* band = n >= 1000 ? "per-draw"')
        w('                         : n >= 100 ? "per-frame"')
        w('                         : n >= 10  ? "setup"')
        w('                                    : "once";')
        w('        fprintf(stderr, "  sub_%08X %10llu  %s\\n", e.second, n, band);')
        w("    }")
        w("}")
        w()
        w('extern "C" void d3d_trace_report() { rexnative_harvest_report(); }')


def cmd_harvest(args):
    """Attribute a runtime reach trace to the candidate library region.

    Static structure gets the public API wrong (39% recall), but it does not
    have to be right - it only has to BOUND the region. Call frequency from a
    real run then decides: once at startup is device creation, once a frame is
    present, thousands between presents is state or drawing.

    Since Stage 0 the counts come from the generated prologue itself
    (-DREX_GUEST_REACH on <title>_recomp, REX_TRACE_REACH=<csv>), so no
    instrumentation TU is needed. --emit-counters still writes the old TU for
    a port that cannot rebuild its recomp library, and it is the only way to
    get ring attribution (--attribute-ring): that needs a checksum AROUND each
    call, which a csv of counts cannot carry. Without it --attribute-ring falls
    back to the static classification `reaches_ring_import`.
    """
    ing = load_ingest(args.ingest)
    lib = lib_of(args)
    counts, src = load_counts(args.reach, args.counts)
    if args.reach and not counts:
        sys.exit("no addr,count rows in " + args.reach)
    region_override = parse_range(args.range) if args.range else None
    h = harvest_core(ing, lib, args.pad, counts, region_override)
    lo, hi = h["_region"]
    region = [int(r["addr"], 16) for r in h["functions"]]
    entry = [int(r["addr"], 16) for r in h["functions"] if r["entry"]]

    out_dir = os.path.join(ing["port"], "out", "rexnative")
    os.makedirs(out_dir, exist_ok=True)
    dest = args.out or os.path.join(out_dir, "harvest_%s.json" % lib)
    public = {k: v for k, v in h.items() if not k.startswith("_")}
    public["reach"] = os.path.abspath(src) if src else None
    public["ring_attribution"] = ("static: reaches_ring_import (transitive within the region to %s); "
                                  "checksum attribution needs --emit-counters" % ", ".join(sorted(RING_IMPORTS)))
    with open(dest, "w") as fh:
        json.dump(public, fh, indent=2)

    tu = None
    if args.emit_counters:
        tu = os.path.join(out_dir, "harvest_%s.cpp" % lib)
        write_counter_tu(tu, lib, lo, hi, region, entry, args)

    ing.setdefault("harvest", {})[lib] = {
        "region": "0x%08X..0x%08X" % (lo, hi),
        "instrumented": len(region),
        "api_candidates": len(entry),
        "reached": public["summary"]["reached"],
        "reach": public["reach"],
        "frames": h["frames"],
        "json": dest,
        "source": tu,
    }
    save_ingest(ing)

    s = public["summary"]
    print("== rexnative harvest: %s / %s ==" % (ing["slug"], lib))
    print("  candidate region    %08X-%08X  (seed span %s, pad 0x%X)" % (lo, hi, h["seed_span"], args.pad))
    print("  in region           %d functions" % s["in_region"])
    print("  called from outside %d  (public API candidates)" % s["api_candidates"])
    print("  ring candidates     %d  (static: reach a ring import)" % s["ring_candidates"])
    if counts:
        print("  reach trace         %s" % src)
        print("  reached             %d of %d in region, %d of them API candidates, %d calls%s"
              % (s["reached"], s["in_region"], s["reached_api_candidates"], s["calls_total"],
                 (", %d frames" % h["frames"]) if h["frames"] else ""))
        bands = collections.Counter(r["band"] for r in h["functions"] if r["count"])
        print("  bands               " + "  ".join("%s %d" % (b, bands[b]) for b in
                                                  ("per-draw", "per-frame", "setup", "once") if bands[b]))
        top = sorted((r for r in h["functions"] if r["count"]), key=lambda r: -r["count"])[:10]
        for r in top:
            print("    sub_%s %10d  %-9s %s%s" % (r["addr"], r["count"], r["band"],
                                                  "API " if r["entry"] else "int ",
                                                  ",".join(r["roles"])))
    else:
        print("  reach trace         none - counts are unmeasured. Build the port with")
        print("                      -DREXGLUE_GUEST_REACH=ON, run with REX_TRACE_REACH=<csv>,")
        print("                      then rerun with --reach <csv>.")
    if args.attribute_ring and not args.emit_counters:
        print("  --attribute-ring    static classification only (reaches_ring_import);")
        print("                      pass --emit-counters for checksum attribution.")
    print("  -> %s" % dest)
    if tu:
        print("  -> %s  (legacy counter TU)" % tu)
    return 0


