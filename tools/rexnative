def parse_addr(v):
    if isinstance(v, int):
        return v
    s = str(v).strip()
    if s.lower().startswith("sub_"):
        s = s[4:]
    if s.lower().startswith("0x"):
        return int(s, 16)
    return int(s, 16) if re.fullmatch(r"[0-9A-Fa-f]{8}", s) else int(s, 0)


def load_entrypoint_names(path):
    """A1's entrypoints.json (any of the accepted shapes) -> {addr: item}."""
    with open(path) as fh:
        doc = json.load(fh)
    items = doc
    if isinstance(doc, dict):
        items = doc.get("entries") or doc.get("entrypoints") or []
    by = {}
    for it in items:
        if not isinstance(it, dict):
            continue
        a = it.get("address", it.get("va", it.get("addr")))
        if a is None:
            continue
        by[parse_addr(a)] = it
    return by


def load_arity_file(path):
    """docs/<lib>/arity.json: {ADDR: {arity_gpr: n}} or {ADDR: n}."""
    with open(path) as fh:
        doc = json.load(fh)
    out = {}
    for k, v in doc.items():
        try:
            a = parse_addr(k)
        except ValueError:
            continue
        if isinstance(v, dict):
            v = v.get("arity_gpr", v.get("arity"))
        if isinstance(v, int):
            out[a] = v
    return out


def estimate_arity(ing, addrs):
    """Arity from the disassembly comments, for the selected addresses only.

    Uses codegen.partition.json to open just the files that hold them. Same
    rule as `describe`: an argument register r3..r10 read before it is written,
    up to the first call.
    """
    gen = ing.get("ppc_dir")
    part = os.path.join(gen, "codegen.partition.json")
    if not os.path.exists(part):
        return {}
    with open(part) as fh:
        assign = json.load(fh).get("assignments", {})
    by_file = collections.defaultdict(set)
    for a in addrs:
        idx = assign.get("%08X" % a)
        if idx is not None:
            by_file[idx].add(a)
    STORES = ("stw", "sth", "stb", "stfs", "stfd", "stwu", "stwx", "stbx", "sthx", "stvx", "stfsx", "stwcx.")
    NO_DEST = STORES + ("cmplw", "cmplwi", "cmpw", "cmpwi", "b", "bl", "beq", "bne", "blt", "bgt",
                        "ble", "bge", "bdnz", "blr", "mtctr", "mtlr", "bctr", "bctrl")
    out = {}
    for idx, wanted in by_file.items():
        paths = glob.glob(os.path.join(gen, "*_recomp.%d.cpp" % idx))
        if not paths:
            continue
        cur, ops = None, {}
        with open(paths[0], errors="ignore") as fh:
            for line in fh:
                m = FUNC_RE_REX.search(line) or FUNC_RE.search(line)
                if m:
                    cur = int(m.group(1), 16)
                    if cur in wanted:
                        ops[cur] = []
                    continue
                if cur in ops and len(ops[cur]) < 120 and line.lstrip().startswith("// "):
                    ops[cur].append(line.strip()[3:])
        for a, body in ops.items():
            written, argc = set(), 0
            for op in body:
                parts = op.replace(",", " ").split()
                if not parts:
                    continue
                mnem = parts[0]
                regs = [int(mm.group(1)) for mm in re.finditer(r"\br([0-9]+)\b", op)]
                if not regs:
                    continue
                dest = None if mnem in NO_DEST else regs[0]
                for r in regs:
                    if r == dest:
                        continue
                    if 3 <= r <= 10 and r not in written:
                        argc = max(argc, r - 2)
                if dest is not None:
                    written.add(dest)
                if mnem in ("bl", "bctrl"):
                    break
            out[a] = argc
    return out


def load_existing_table(path):
    """Existing api_table.toml -> {addr: raw entry} so hand edits survive."""
    if not os.path.exists(path):
        return {}, {}
    with open(path, "rb") as fh:
        doc = tomllib.load(fh)
    return doc.get("meta", {}), {parse_addr(e["address"]): e for e in doc.get("entry", []) if "address" in e}


def cpp_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def toml_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def select_entries(ing, lib, h, args, names_by_addr, arity_by_addr, existing, mranges):
    rows = {int(r["addr"], 16): r for r in h["functions"]}
    in_module = lambda a: any(lo <= a <= hi for lo, hi in mranges)
    measured = any(r["count"] for r in rows.values())
    picked = set()
    for spec in (args.pick or []):
        for tok in spec.split(","):
            if tok.strip():
                picked.add(parse_addr(tok))
    only = set()
    for spec in (args.only or []):
        for tok in spec.split(","):
            if tok.strip():
                only.add(parse_addr(tok))
    missing_only = sorted(only - rows.keys())
    if missing_only:
        sys.exit("--only outside the region: " + " ".join("%08X" % a for a in missing_only))
    if only:
        picked = only
    chosen = set()
    for a, r in rows.items():
        if only:
            break
        if r["roles"]:
            chosen.add(a)
        elif not in_module(a):
            continue
        elif r["entry"] and (not measured or r["count"] >= args.min_count):
            chosen.add(a)
        elif args.include_internal and measured and r["count"] >= max(args.min_count, 1):
            chosen.add(a)
    if args.keep_existing:
        chosen |= {a for a in existing if a in rows}
    chosen |= {a for a in picked if a in rows}
    missing = [a for a in picked if a not in rows]
    if missing:
        print("  warning: --pick outside the region, ignored: " + " ".join("%08X" % a for a in missing))

    # A function called orders of magnitude more than the next is a poll loop,
    # not an API rate. Flag it rather than letting it distort the ordering.
    ordered = sorted(chosen, key=lambda a: -rows[a]["count"])
    poll = set()
    for i in range(len(ordered) - 1):
        if rows[ordered[i]]["count"] > 50 * max(rows[ordered[i + 1]]["count"], 1) and rows[ordered[i]]["count"] > 1000:
            poll.add(ordered[i])

    entries = []
    for a in sorted(chosen):
        r = rows[a]
        prev = existing.get(a, {})
        role = prev.get("role") or (r["roles"][0] if r["roles"] else "")
        name = prev.get("name") or ""
        if not name or name == "sub_%08X" % a:
            it = names_by_addr.get(a, {})
            jn = it.get("xdk_name") or it.get("name")
            if jn and IDENT_RE.match(str(jn)) and not str(jn).lower().startswith("sub_"):
                name = str(jn)
            elif role in ROLE_NAMES:
                name = ROLE_NAMES[role]
            else:
                name = "sub_%08X" % a
        arity = prev.get("arity")
        if arity is None:
            it = names_by_addr.get(a, {})
            arity = it.get("arity") if isinstance(it.get("arity"), int) else arity_by_addr.get(a)
        tier = 1 if r["entry"] else 2
        if r["count"] == 0 and measured:
            tier = 3
        evidence = ["static:callers-outside-region"] if r["entry"] else ["static:internal"]
        if measured:
            evidence.append("reach:%s" % os.path.basename(h.get("reach") or "csv"))
        if a in names_by_addr:
            evidence.append("entrypoints:" + os.path.basename(args.entrypoints or "json"))
        if r["reaches_ring_import"]:
            evidence.append("static:reaches-ring-import")
        if a in picked:
            evidence.append("pick")
        if a in poll:
            evidence.append("poll-loop")
        freq = ("%d calls, %s" % (r["count"], r["band"]) if measured else "unmeasured (no reach trace)")
        if a in poll:
            freq += ", POLL LOOP - not an API rate"
        entries.append({
            "address": a, "name": name, "arity": arity, "mode": prev.get("mode", "guest"),
            "role": role, "note": prev.get("note") or freq, "freq": freq, "count": r["count"],
            "band": r["band"], "tier": tier, "callers": r["callers_outside"],
            "evidence": evidence, "imports": r["imports"], "poll": a in poll,
        })
    return entries, measured


def gen_api_table(ing, lib, entries, region, meta_prev):
    L = []
    w = L.append
    title = ing["title"]
    w("# %s %s band: address -> {name, arity, mode}. Source of truth for the" % (title, lib))
    w("# generated overrides in gen/overrides.cpp; it lives outside generated/ so")
    w("# `rexglue codegen` never touches it. Written by `rexnative emit`; rerunning")
    w("# emit keeps the name, arity, mode, role and note you set here per address")
    w("# and refreshes the measured frequency (`freq`).")
    w("#")
    w("# Per-entry fields")
    w("#   address  guest VA of the function (the generated symbol is sub_<ADDRESS>)")
    w("#   name     identifier used in logs and native hook symbol names; entries")
    w("#            still named sub_XXXXXXXX are provisional (no entrypoints.json name)")
    w("#   arity    integer arguments in r3.. (logging/tracing only; no ABI effect)")
    w("#   mode     what the override does when the cvar %s_%s is \"native\":" % (title, lib))
    w("#              guest   forward to __imp__sub_X unchanged")
    w("#              tee     call hooks::TeePre_<ADDR> / TeePost_<ADDR> around the forward")
    w("#              native  call hooks::Native_<ADDR>, never forward (fatal if unbound)")
    w("#              fatal   REX_FATAL: an internal-only function that must be")
    w("#                      unreachable once its callers are native")
    w("#   role     optional: \"present\" marks the frame boundary, \"ring_init\" the")
    w("#            ring buffer initialisation")
    w("#   freq     measured call frequency from the reach trace (regenerated)")
    w("#   note     free text")
    w("")
    w("[meta]")
    w("title = %s" % toml_str(title))
    w("lib = %s" % toml_str(lib))
    w("symbol_prefix = \"sub_\"")
    w("region = %s" % toml_str("%08X-%08X" % region))
    w("generator = \"rexnative emit\"")
    w("")
    for e in entries:
        w("[[entry]]")
        w("address = 0x%08X" % e["address"])
        w("name = %s" % toml_str(e["name"]))
        if e["arity"] is not None:
            w("arity = %d" % e["arity"])
        w("mode = %s" % toml_str(e["mode"]))
        if e["role"]:
            w("role = %s" % toml_str(e["role"]))
        w("freq = %s" % toml_str(e["freq"]))
        if e["note"] and e["note"] != e["freq"]:
            w("note = %s" % toml_str(e["note"]))
        w("")
    return "\n".join(L)


def gen_entrypoints_json(ing, lib, entries, h, measured):
    return json.dumps({
        "format": "rex-native-entrypoints/1",
        "title": ing["title"],
        "lib": lib,
        "region": h["region"],
        "reach": h.get("reach"),
