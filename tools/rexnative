def read_reach(path):
    """REX_TRACE_REACH csv: `addr,count` header, 8-hex addr rows (FORMATS.md)."""
    counts = {}
    with open(path, errors="ignore") as fh:
        for i, line in enumerate(fh):
            line = line.strip()
            if not line or (i == 0 and line.lower().startswith("addr")):
                continue
            parts = line.split(",")
            if len(parts) < 2:
                continue
            a = parts[0].strip()
            if a.lower().startswith("sub_"):
                a = a[4:]
            if not re.fullmatch(r"[0-9A-Fa-f]{8}", a):
                continue   # hand-written REX_FUNC_PROLOGUE user without an address
            try:
                counts[int(a, 16)] = int(parts[1].strip())
            except ValueError:
                continue
    return counts


def read_counts(path):
    """Legacy: a log containing the counter TU's `sub_X  N  band` lines."""
    counts = {}
    for line in open(path, errors="ignore"):
        m = re.match(r"\s+sub_([0-9A-F]{8})\s+(\d+)\s+\S+", line)
        if m:
            counts[int(m.group(1), 16)] = int(m.group(2))
    return counts


def load_counts(reach=None, counts_log=None):
    """(counts, source_label). Auto-detects a csv given through --counts."""
    if reach:
        return read_reach(reach), reach
    if counts_log:
        with open(counts_log, errors="ignore") as fh:
            first = fh.readline().strip().lower()
        if first.startswith("addr,count"):
            return read_reach(counts_log), counts_log
        return read_counts(counts_log), counts_log
    return {}, None


def band_of(count, frames=None):
    if count <= 0:
        return "unreached"
    if frames and frames >= 10:
        per = count / frames
        if per >= 8:
            return "per-draw"
        if per >= 0.5:
            return "per-frame"
        return "setup" if count >= 10 else "once"
    if count >= 1000:
        return "per-draw"
    if count >= 100:
        return "per-frame"
    return "setup" if count >= 10 else "once"


