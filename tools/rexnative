            "arity": e["arity"],
            "tier": e["tier"],
            "role": e["role"] or None,
            "count": e["count"],
            "band": e["band"],
            "callers": e["callers"],
            "evidence": e["evidence"],
            "imports": e["imports"],
        } for e in entries],
