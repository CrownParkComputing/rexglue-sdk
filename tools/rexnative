def load_native_toml(port):
    p = os.path.join(port, "native.toml")
    if not os.path.exists(p):
        return {}
    with open(p, "rb") as fh:
        return tomllib.load(fh).get("module", {})


def load_symbols(port, allow_run=True):
    p = os.path.join(port, "out", "native", "symbols.json")
    if not os.path.exists(p) and allow_run:
        tool = os.path.join(SDK_DIR, "tools", "native_map.py")
        if os.path.exists(tool) and glob.glob(os.path.join(port, "out", "build", "*")):
            subprocess.run([sys.executable, tool, port], capture_output=True, text=True)
    if not os.path.exists(p):
        return None
    with open(p) as fh:
        return json.load(fh)


def module_coverage(port, lib, mod, symbols, counts):
    ranges = []
    for r in mod.get("ranges", []):
        ranges.append(parse_range(r))
    if not ranges and mod.get("range"):
        ranges.append(parse_range(mod["range"]))

    def inside(a):
        return any(lo <= a <= hi for lo, hi in ranges)

    row = {"lib": lib, "ranges": ["%08X-%08X" % r for r in ranges], "policy": mod.get("policy", "?")}
    if symbols:
        st = collections.Counter()
        weight = collections.Counter()
        for addr, s in symbols["symbols"].items():
            a = int(addr, 16)
            if not inside(a):
                continue
            st[s["status"]] += 1
            if counts:
                weight[s["status"]] += counts.get(a, 0)
        total = sum(st.values())
        row.update({"functions": total, "generated": st["generated"], "displaced": st["displaced"],
                    "dropped": st["dropped"],
                    "pct_displaced": (100.0 * st["displaced"] / total) if total else 0.0})
        if counts:
            wt = sum(weight.values())
            row.update({"calls": wt, "calls_generated": weight["generated"],
                        "pct_calls_displaced": (100.0 * (wt - weight["generated"]) / wt) if wt else 0.0})
    elif counts:
        reached = {a: n for a, n in counts.items() if inside(a)}
        row.update({"reached": len(reached), "calls": sum(reached.values())})
    return row


def coverage_line(row):
    s = "  %-6s range %-20s policy %-13s" % (row["lib"], ",".join(row["ranges"]), row["policy"])
    if "functions" in row:
        s += " funcs %4d: displaced %3d (%5.1f%%) generated %4d dropped %3d" % (
            row["functions"], row["displaced"], row["pct_displaced"], row["generated"], row["dropped"])
        if "calls" in row:
            s += " | reach %d calls, %.1f%% off the guest body" % (row["calls"], row["pct_calls_displaced"])
        else:
            s += " | reach n/a"
    elif "reached" in row:
        s += " symbols.json n/a | reach %d functions, %d calls" % (row["reached"], row["calls"])
    else:
        s += " symbols.json n/a, reach n/a"
    return s


def find_reach(args, port):
    if getattr(args, "reach", None):
        return args.reach
    for cand in (os.environ.get("REX_TRACE_REACH"), os.path.join(port, "out", "native", "reach.csv"),
                 os.path.join(port, "out", "rexnative", "reach.csv")):
        if cand and os.path.exists(cand):
            return cand
    return None


