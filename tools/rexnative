#!/usr/bin/env python3
"""
rexnative - end-to-end native recompilation of an Xbox 360 title.

The method: use the working emulator OFFLINE as a data source, not as the
runtime. Everything the native binary needs is extracted ahead of time and
baked in, so the shipped binary discovers nothing at run time. Every previous
attempt had the runtime discover the guest's GPU work as it happened - rexglue
emulates EDRAM from the PM4 stream, rexgpu-native infers a resolve graph from
it - and both pay that cost every frame while having to be right about
semantics they can only guess at.

Stages:
    ingest     XEX / port -> build description (call graph, seeds per library)
    harvest    bound the library region and attribute a runtime reach trace
               (REX_TRACE_REACH csv) to it: call frequency per function,
               public-API candidates, static ring-writer classification
    describe   RE dossier per entry point (arity, r3 offsets, imports)
    emit       PORT/native.toml + PORT/src/<lib>native/{entrypoints.json,
               api_table.toml, gen/overrides.cpp, gen/record.cpp,
               <lib>_native.{h,cpp}, README.md}; every entry starts as a
               guest-forwarding hook with its measured frequency in a comment
    link       PORT/src/<lib>native/sources.cmake and the include() line
    verify     native_check.py, snap_replay, tee_diff.py -> VERIFY.md
    status     coverage line per module from native.toml + symbols.json + reach
    translate  ucode -> SPIR-V table (harvest-and-bake)
    rendergraph render graph -> static table (harvest-and-bake)

Typical flow for a new library on a port:

    rexnative ingest  PORT
    #  build PORT with -DREXGLUE_GUEST_REACH=ON, run with REX_TRACE_REACH=reach.csv
    rexnative harvest PORT/out/rexnative/ingest.json --lib d3d9 --reach reach.csv
    rexnative emit    PORT/out/rexnative/ingest.json --lib d3d9 [--dry-run]
    rexnative link    PORT --lib d3d9
    rexnative verify  PORT --lib d3d9
    rexnative status  PORT
"""

import argparse
import collections
import difflib
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import tomllib

SDK_DIR = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))

# A statically linked middleware library is identified by the kernel imports
# only it can call: nothing but the graphics library talks to the video
# hardware, and nothing but the audio library talks to XMA.
SUBSYSTEM_IMPORTS = {
    "d3d9":  re.compile(r"__imp__(Vd[A-Za-z]+)\b"),
    "audio": re.compile(r"__imp__(XAudio[A-Za-z]+|XMA[A-Za-z]+)\b"),
}
# Imports that touch the command ring or its registers. A function that reaches
# one of these (within the library) is a ring/submission candidate; PM4 itself
# is written with ordinary stores that no static scan sees.
RING_IMPORTS = {
    "VdSwap", "VdInitializeRingBuffer", "VdEnableRingBufferRPtrWriteBack",
    "VdGetSystemCommandBuffer", "VdSetSystemCommandBufferGpuIdentifierAddress",
    "VdInitializeEngines", "VdInitializeEDRAM", "VdShutdownEngines",
}
# Role anchors per library: the import whose direct caller gets the role.
ROLE_IMPORTS = {
    "d3d9": {"present": "VdSwap", "ring_init": "VdInitializeRingBuffer"},
}
ROLE_NAMES = {"present": "Present", "ring_init": "RingInit"}

# Two generated layouts: XenonRecomp (ppc_recomp.N.cpp, PPC_FUNC_IMPL) and
# rexglue codegen (<title>_recomp.N.cpp, DEFINE_REX_FUNC). Call sites look the
# same in both.
FUNC_RE = re.compile(r"PPC_FUNC_IMPL\(__imp__sub_([0-9A-F]{8})\)")
FUNC_RE_REX = re.compile(r"DEFINE_REX_FUNC\(sub_([0-9A-Fa-f]{8})\)")
CALL_RE = re.compile(r"\bsub_([0-9A-Fa-f]{8})\(ctx, base\)")
IMPORT_RE = re.compile(r"__imp__([A-Za-z][A-Za-z0-9_]*)")
IDENT_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")

MODES = {"guest": "kGuest", "tee": "kTee", "native": "kNative", "fatal": "kFatal"}
ROLES = {"": "kNone", "present": "kPresent", "ring_init": "kRingInit"}


def recomp_sources(ppc_dir):
    srcs = sorted(glob.glob(os.path.join(ppc_dir, "ppc_recomp.*.cpp")))
    if not srcs:
        srcs = sorted(glob.glob(os.path.join(ppc_dir, "*_recomp.*.cpp")))
    return srcs


def scan_recompiled(ppc_dir, cache_dir=None):
    """Call graph, per-function kernel imports and per-subsystem seeds.

    Returns (funcs, calls, seeds, imports). The scan of a large title takes a
    while (PGR4: 139 MB of sources), so the result is cached under cache_dir as
    graph.json keyed by the newest source mtime.
    """
    sources = recomp_sources(ppc_dir)
    if not sources:
        sys.exit("no recompiled sources in " + ppc_dir)
    newest = max(os.path.getmtime(p) for p in sources)
    cache = os.path.join(cache_dir, "graph.json") if cache_dir else None
    if cache and os.path.exists(cache):
        try:
            with open(cache) as fh:
                g = json.load(fh)
            if g.get("ppc_dir") == ppc_dir and g.get("newest") == newest and g.get("files") == len(sources):
                funcs = set(int(a, 16) for a in g["funcs"])
                calls = collections.defaultdict(set, {int(a, 16): set(int(b, 16) for b in bs)
                                                      for a, bs in g["calls"].items()})
                imports = collections.defaultdict(set, {int(a, 16): set(v) for a, v in g["imports"].items()})
                return funcs, calls, seeds_from_imports(imports), imports
        except (OSError, ValueError, KeyError):
            pass

    calls = collections.defaultdict(set)
    imports = collections.defaultdict(set)
    funcs = set()
    for path in sources:
        cur = None
        with open(path, errors="ignore") as fh:
            for line in fh:
                m = FUNC_RE.search(line) or FUNC_RE_REX.search(line)
                if m:
                    cur = int(m.group(1), 16)
                    funcs.add(cur)
                    continue
                if cur is None:
                    continue
                if "__imp__" in line:
                    for imp in IMPORT_RE.findall(line):
                        if not imp.startswith("sub_"):
                            imports[cur].add(imp)
                for callee in CALL_RE.findall(line):
                    calls[cur].add(int(callee, 16))
    if cache:
        os.makedirs(cache_dir, exist_ok=True)
        with open(cache, "w") as fh:
            json.dump({"ppc_dir": ppc_dir, "newest": newest, "files": len(sources),
                       "funcs": ["%08X" % a for a in sorted(funcs)],
                       "calls": {"%08X" % a: ["%08X" % b for b in sorted(bs)] for a, bs in calls.items()},
                       "imports": {"%08X" % a: sorted(v) for a, v in imports.items()}}, fh)
    return funcs, calls, seeds_from_imports(imports), imports


def seeds_from_imports(imports):
    seeds = {k: {} for k in SUBSYSTEM_IMPORTS}
    for addr, imps in imports.items():
        for name, rx in SUBSYSTEM_IMPORTS.items():
            hit = {i for i in imps if rx.match("__imp__" + i)}
            if hit:
                seeds[name][addr] = hit
    return seeds


def callers_of(calls):
    rev = collections.defaultdict(set)
    for a, bs in calls.items():
        for b in bs:
            rev[b].add(a)
    return rev


def detect_title(port, slug):
    """The CMake target / codegen prefix: <title>_init.cpp under generated/."""
    for init in sorted(glob.glob(os.path.join(port, "generated", "*", "*_init.cpp"))):
        return os.path.basename(init)[: -len("_init.cpp")]
    for man in sorted(glob.glob(os.path.join(port, "*_manifest.toml"))):
        return os.path.basename(man)[: -len("_manifest.toml")]
    return slug


def load_ingest(path_or_port):
    """Accept either an ingest.json or a port directory."""
    p = os.path.abspath(path_or_port)
    if os.path.isdir(p):
        p = os.path.join(p, "out", "rexnative", "ingest.json")
    if not os.path.exists(p):
        sys.exit("no ingest at %s - run `rexnative ingest <port>` first" % p)
    with open(p) as fh:
        ing = json.load(fh)
    ing["_path"] = p
    ing.setdefault("title", detect_title(ing["port"], ing["slug"]))
    return ing


def save_ingest(ing):
    path = ing.pop("_path")
    with open(path, "w") as fh:
        json.dump(ing, fh, indent=2)
    ing["_path"] = path


def lib_of(args):
    return getattr(args, "lib", None) or getattr(args, "subsystem", None) or "d3d9"


def cmd_ingest(args):
    port = os.path.abspath(args.port)
    slug = os.path.basename(port)
    if slug.endswith("-recomp"):
        slug = slug[: -len("-recomp")]
    title = detect_title(port, slug)

    ppc_dir = args.ppc or os.path.join(port, "ppc")
    if not os.path.isdir(ppc_dir):
        ppc_dir = os.path.join(port, "generated", "default")

    gen = os.path.join(port, "generated", "default")
    fn_toml = os.path.join(gen, slug + "_xenonrecomp.toml")
    sw_toml = os.path.join(gen, title + "_switch_tables.toml")
    if not os.path.exists(sw_toml):
        sw_toml = os.path.join(gen, slug + "_switch_tables.toml")
    symbols = os.path.join(port, "out", "native", "symbols.json")

    out = {
        "slug": slug,
        "title": title,
        "port": port,
        "ppc_dir": ppc_dir,
        "sdk": SDK_DIR,
        "boundaries": fn_toml if os.path.exists(fn_toml) else None,
        "switch_tables": sw_toml if os.path.exists(sw_toml) else None,
        "symbols": symbols if os.path.exists(symbols) else None,
    }
    if out["boundaries"]:
        out["function_count"] = sum(
            1 for l in open(out["boundaries"], errors="ignore") if "{ address" in l)
    if out["switch_tables"]:
        out["switch_table_count"] = sum(
            1 for l in open(out["switch_tables"], errors="ignore") if l.startswith("[[switch]]"))

    cache_dir = os.path.join(port, "out", "rexnative")
    funcs, calls, seeds, imports = scan_recompiled(ppc_dir, cache_dir)
    out["recompiled_functions"] = len(funcs)
    out["call_edges"] = sum(len(v) for v in calls.values())
    out["kernel_imports_used"] = len({i for v in imports.values() for i in v})

    # What static analysis can say for certain, and what it cannot.
    #
    # The seeds are sound: a function that calls VdSwap is in the graphics
    # library, full stop. What static structure does NOT reliably give is the
    # library's PUBLIC API - the functions game code calls in through. Measured
    # on Geometry Wars, a modularity partition of the call graph recovered that
    # set at 39% recall and 46% precision, while producing a plausible count
    # (56 against 66 known) that would pass a shallow check.
    #
    # The signal that does work is call FREQUENCY from a real run. That is
    # harvest data (the reach trace), so the partition is only proposed here.
    out["middleware"] = {}
    for name, found in seeds.items():
        out["middleware"][name] = {
            "seed_functions": ["0x%08X" % a for a in sorted(found)],
            "seed_imports": sorted({i for s in found.values() for i in s}),
            "span": ("0x%08X..0x%08X" % (min(found), max(found))) if found else None,
            "confidence": "seeds are certain; public API needs harvest call-frequency",
        }

    dest = args.out or os.path.join(port, "out", "rexnative", "ingest.json")
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    # Keep harvest/emit records from an earlier run of the same port.
    prev = {}
    if os.path.exists(dest):
        try:
            with open(dest) as fh:
                prev = json.load(fh)
        except ValueError:
            prev = {}
    for k in ("harvest", "emit", "link", "verify"):
        if k in prev:
            out[k] = prev[k]
    with open(dest, "w") as fh:
        json.dump(out, fh, indent=2)

    print("== rexnative ingest: %s (%s) ==" % (slug, title))
    print("  recompiled functions %d" % out["recompiled_functions"])
    print("  call edges           %d" % out["call_edges"])
    print("  kernel imports used  %d" % out["kernel_imports_used"])
    if out.get("function_count"):
        print("  boundaries           %d" % out["function_count"])
    if out.get("switch_table_count"):
        print("  switch tables        %d" % out["switch_table_count"])
    if out["symbols"]:
        print("  symbols.json         %s" % out["symbols"])
    for name, info in out["middleware"].items():
        n = len(info["seed_functions"])
        if n:
            print("  %-6s seeds        %d functions, span %s" % (name, n, info["span"]))
            shown = " ".join(info["seed_imports"][:4])
            print("         via          %s%s" % (shown, " ..." if len(info["seed_imports"]) > 4 else ""))
    print("  -> %s" % dest)
    print()
    print("  Public API partition is NOT decided here - static structure gives")
    print("  39% recall on it. It is resolved in `rexnative harvest` from a reach trace.")
    return 0


